# onnxruntime-node fetches an optional CUDA build from GitHub on Linux installs; that
# download went 404 on 2026-11-17 and failed every workflow at npm ci. We only run on CPU.
# npm warns that it will stop reading unknown keys like this one; the workflows also
# set npm_config_onnxruntime_node_install_cuda=skip in their env, which does not depend
# on it. Kept here for local installs.
onnxruntime-node-install-cuda=skip
