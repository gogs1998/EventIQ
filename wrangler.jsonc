{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eventiq",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  // nodejs_compat is required by the Next.js adapter. global_fetch_strictly_public
  // makes outbound fetch behave like a browser's, which matters because the record
  // importer fetches a third-party page from inside the Worker.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "eventiq"
    }
  ],
  // The one published show EventIQ's own shop window runs on: the pitch page,
  // the sitemap, /f/demo and the /qr redirect. It used to be whichever published
  // show had the furthest-out date, which is a rule that hands the front page to
  // the second promoter to publish. A var rather than a secret because it names
  // something public, and because changing which show is on display should be a
  // deploy with a diff rather than a `wrangler secret put` nobody can read back.
  //
  // Unset, or naming a show that is not published, means no showcase: the pitch
  // page makes its argument without a live card. See lib/db/queries.ts.
  "vars": {
    "SHOWCASE_SLUG": "cage-county-12",
    // Whether the opt-in stylised portrait is offered. Off unless this says on:
    // it sends a real fighter's photograph to a model, which is a decision
    // somebody makes rather than a default.
    "STYLISED_PORTRAITS": "off",
    // Which Worker this is, for /api/health and the deploy script to say so.
    "EVENTIQ_ENV": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eventiq",
      // Replaced by the id printed by `wrangler d1 create eventiq`. Local
      // development ignores this and uses the Miniflare database under
      // .wrangler/state, so the placeholder does not stop anything working.
      "database_id": "74fbf335-d41d-42e7-8d18-41905dccd60e",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [
    {
      // Fighter photographs and rendered mp4s. Not the Next.js cache: that is a
      // separate concern and gets its own bucket if it is ever wanted.
      "binding": "MEDIA",
      "bucket_name": "eventiq-media"
    }
  ],
  // Workers AI, reached only by the opt-in stylised portrait, through
  // @cf/runwayml/stable-diffusion-v1-5-img2img. Not declared here, on purpose:
  // with an `ai` binding in the config, the dev server's Miniflare re-created
  // its bindings part way through a session and every D1 and R2 call after
  // that answered "poisoned stub" until a restart — a whole browser walkthrough
  // died of it. The action reads env.AI and answers "not available here" when
  // it is absent, so nothing else notices. To offer stylised portraits on a
  // deployment, add the binding below alongside STYLISED_PORTRAITS=on, and keep
  // the dev server on a config without it.
  //
  //   "ai": { "binding": "AI" },
  //
  "ratelimits": [
    {
      // Bounds /api/import-record, which takes no token by design. Counted at
      // the edge rather than in D1, because a counter in the database would
      // answer an unauthenticated flood with a write per request. The namespace
      // id is local to this Worker and needs no provisioning.
      "name": "IMPORT_LOOKUPS",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      // Bounds guessing at the promoter's password. This counts callers; the
      // per-account lockout in lib/lockout.ts is what covers a guess spread
      // across a lot of them.
      "name": "LOGIN_ATTEMPTS",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      // Bounds /api/track, which every spectator's programme posts to and which
      // writes a row each time. Loose enough for a hall of people behind one
      // venue address.
      "name": "TRACK_WRITES",
      "namespace_id": "1003",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  // Workers Logs. Nothing phoned home before this and a 500 on show night stayed
  // a 500 until somebody signed in and found it — HANDOVER section 20, and bug
  // 16, which was exactly that for a fortnight.
  //
  // head_sampling_rate is 1 rather than the default, because the traffic here is
  // one promoter and a few hundred spectators for ninety minutes: sampling saves
  // nothing worth having and loses the one request that went wrong. Revisit it
  // if a show ever puts real load through this, not before.
  //
  // logs.enabled turns on the console output the app writes through lib/log.ts,
  // and invocation_logs keeps the one line per request that says which route and
  // what status, which is what makes a structured error joinable to the request
  // it came from. Section 12a has how to read them.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  },
  // Which Worker answered, in the one place an unauthenticated caller can read
  // it: /api/health. The end-to-end suite writes as it goes — it adds a bout,
  // removes it and fills a fighter's profile in — so "which environment am I
  // pointed at" is a question that has to be answerable before it starts rather
  // than afterwards. See .github/workflows/e2e-staging.yml.
  // A second Worker, with its own database and its own bucket, for the suite
  // that writes and for anything else worth trying before eventiq.win sees it.
  //
  // Everything a binding is has to be repeated here: wrangler inherits the
  // build settings — main, the compatibility date and flags, the assets
  // directory, observability — and deliberately does not inherit bindings or
  // vars, so an environment cannot end up silently pointed at production's
  // database by leaving a line out. The ratelimit namespace ids are local to a
  // Worker and need no provisioning, so they are the same numbers.
  //
  // There is no route or custom domain here. `wrangler deploy --env staging`
  // gives it eventiq-staging.<subdomain>.workers.dev, which is enough for the
  // suite and for a link to somebody. Attaching staging.eventiq.win is an
  // optional step and is in DEPLOY.md rather than in this file, because it
  // wants a zone permission the deploy otherwise does not need.
  "env": {
    "staging": {
      "name": "eventiq-staging",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "eventiq-staging"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "eventiq-staging",
          // Written by `node scripts/deploy.mjs --env staging --provision`.
          "database_id": "e26f3b1f-e188-43a2-abe8-f5df09d55a72",
          "migrations_dir": "db/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "eventiq-media-staging"
        }
      ],
      "ratelimits": [
        {
          "name": "IMPORT_LOOKUPS",
          "namespace_id": "1001",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "LOGIN_ATTEMPTS",
          "namespace_id": "1002",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "TRACK_WRITES",
          "namespace_id": "1003",
          "simple": {
            "limit": 60,
            "period": 60
          }
        }
      ],
      // Repeated rather than inherited, because vars are not: without these two
      // staging's pitch page shows no card and wrangler warns about both.
      "vars": {
        "SHOWCASE_SLUG": "cage-county-12",
        "STYLISED_PORTRAITS": "off",
        "EVENTIQ_ENV": "staging"
      }
    }
  }
}
