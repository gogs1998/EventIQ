# Copy to .dev.vars for local development. Never commit the copy.
#
# SESSION_SECRET signs the promoter's login cookie. Any long random string will
# do locally; generate a real one for deployment with:
#   openssl rand -base64 48
SESSION_SECRET=local-development-only-not-a-real-secret

# RENDER_KEY is what the mp4 renderer presents to reach /render/[slug]/[bout],
# which has to serve a card before it is published and so cannot go behind the
# publish check. Without it that page refuses everybody who is not the signed-in
# promoter who owns the show, and `npm run render` stops working. Both the dev
# server and scripts/render-tape.mjs read it from this file.
RENDER_KEY=local-development-only-not-a-real-render-key

# INVITE_KEY signs the digest an invite is found by and encrypts the token the
# dashboard shows back. Leave it out locally and SESSION_SECRET stands in; a
# deployed Worker without it refuses to serve an invite rather than falling back
# to something guessable. Rotating it makes every link already sent out stop
# working, so it goes in the password manager beside the other two.
#   openssl rand -base64 48
INVITE_KEY=local-development-only-not-a-real-invite-key

# The password the seed script sets on the seeded promoter. Change it before
# seeding anything that is reachable from the internet.
SEED_PROMOTER_PASSWORD=letmein

# Loads .env files as development rather than production.
NEXTJS_ENV=development
