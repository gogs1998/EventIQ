{
  "name": "eventiq",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --project db",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/deploy.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply eventiq --local",
    "db:migrate:remote": "wrangler d1 migrations apply eventiq --remote",
    "db:seed": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-alias-loader-register.mjs scripts/seed.ts",
    "db:seed:remote": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-alias-loader-register.mjs scripts/seed.ts -- --remote",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "promoter": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-alias-loader-register.mjs scripts/promoter.mjs",
    "db:migrate-invites": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-alias-loader-register.mjs scripts/migrate-invites.mjs",
    "db:studio": "wrangler d1 execute eventiq --local --command",
    "db:backup": "node scripts/backup.mjs",
    "db:restore-rehearsal": "node scripts/restore-rehearsal.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "icons": "node scripts/make-icons.mjs",
    "cutouts": "node scripts/cutouts.mjs",
    "analytics:rollup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/rollup-analytics.mjs",
    "r2:orphans": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-alias-loader-register.mjs scripts/r2-orphans.mjs",
    "retention": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --import ./scripts/ts-alias-loader-register.mjs scripts/retention.mjs",
    "render": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/render-tape.mjs",
    "render-key": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/render-key.mjs",
    "golden-frames": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/golden-frames.mjs",
    "e2e": "node scripts/e2e.mjs",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.3",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@imgly/background-removal-node": "^1.4.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "puppeteer-core": "^25.9.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "4.126.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.4": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "sharp@0.32.6": true,
    "sharp@0.35.2": true,
    "sharp@0.35.4": true,
    "onnxruntime-node@1.17.3": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260825.1": true
  }
}
